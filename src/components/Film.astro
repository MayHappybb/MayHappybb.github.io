---
// "Seeing vibrations with radar", self-hosted (subtitles are burned into the picture), with a chapter list that seeks the video.
import { type Lang, type T, L } from '../i18n';
interface Props { id?: string; lang: Lang }
const { id = 'film-player', lang } = Astro.props;
// the film's own chapter titles; Chinese ones translate them (the film is in English)
const chapters: [number, T][] = [
  [0, { en: 'Everything shakes', zh: '万物都在振动' }],
  [168, { en: 'Phase: a ruler finer than a hair', zh: '相位：一把比头发丝还细的尺子' }],
  [311, { en: 'The chirp: sorting echoes by distance', zh: 'Chirp：按距离把回波分开' }],
  [559, { en: 'From phase to vibration', zh: '从相位到振动' }],
  [806, { en: 'Many antennas: telling directions apart', zh: '多根天线：分辨方向' }],
  [1061, { en: 'Putting it all together', zh: '把一切串起来' }],
  [1272, { en: 'Where it works, and where it struggles', zh: '哪里好用，哪里吃力' }],
  [1533, { en: 'Epilogue', zh: '尾声' }],
];
const zh = lang === 'zh';
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
---
<figure class="photo film" data-frame>
  <video id={id} controls preload="none" poster="/media/seeing-vibrations.jpg" width="1920" height="1080">
    <source src="/media/seeing-vibrations-with-radar.mp4" type="video/mp4">
    <a href="/media/seeing-vibrations-with-radar.mp4">{zh ? '下载影片（MP4）' : 'Download the film (MP4)'}</a>.
  </video>
  <figcaption>{zh ? 'Seeing vibrations with radar（用雷达看见振动），26:38，共八章，英文旁白和英文字幕。' : 'Seeing vibrations with radar, 26:38, eight chapters, English subtitles.'}</figcaption>
</figure>
<ol class="chapters" data-for={id} aria-label={zh ? '章节' : 'Chapters'}>
  {chapters.map(([t, title], i) => (
    <li><button type="button" data-t={t}><span class="t">{mmss(t)}</span> {i < 7 ? `${i + 1}. ` : ''}{L(lang, title)}</button></li>
  ))}
</ol>
<style>
  .film video { width:100%; height:auto; display:block; position:relative; background:#11161c; }
  .chapters { list-style:none; padding:0; margin:4px 0 24px; }
  .chapters button { background:none; border:0; color:var(--ink); font:inherit; font-size:16px; line-height:1.5; text-align:left; padding:3px 4px 3px 4.2em; text-indent:-3.6em; cursor:pointer; width:100%; }
  .chapters button:hover, .chapters button:focus-visible { background:var(--mark); }
  .chapters .t { font-family:var(--hand); font-weight:700; font-size:19px; color:var(--pencil); font-variant-numeric:tabular-nums; display:inline-block; min-width:3.2em; }
</style>
<script>
  document.querySelectorAll<HTMLOListElement>('ol.chapters').forEach((list) => {
    const video = document.getElementById(list.dataset.for!) as HTMLVideoElement | null;
    if (!video) return;
    list.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      video.currentTime = Number(b.dataset.t);
      video.play().catch(() => {});
      video.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
    });
  });
</script>
