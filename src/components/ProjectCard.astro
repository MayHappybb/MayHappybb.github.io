---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; showImage?: boolean }
const { project, showImage = true } = Astro.props;
const d = project.data;
const href = `/projects/${project.id}/`;
---
<article class="card" data-frame>
  {showImage && d.image && (
    <Image src={d.image} alt={d.imageAlt ?? ''} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 350px" loading="lazy" />
  )}
  <h3 class="title" style="margin:0"><a href={href}>{d.title}</a></h3>
  <p>{d.summary} <span class="yr">{d.year}</span></p>
  {d.status && <p class="small">{d.status}</p>}
</article>
