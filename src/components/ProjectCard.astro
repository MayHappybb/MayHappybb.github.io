---
import Snapshot from './Snapshot.astro';
import type { Project } from '../lib/content';
import { type Lang, lp } from '../i18n';

interface Props { project: Project; lang: Lang; showImage?: boolean }
const { project, lang, showImage = true } = Astro.props;
const d = project.data;
const href = lp(lang, `/projects/${project.id}/`);
---
<article class="card" data-frame>
  {showImage && d.image && (
    <Snapshot src={d.image} alt={d.imageAlt ?? ''} seed={project.id} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 340px" />
  )}
  <h3 class="title" style="margin:0"><a href={href}>{d.title}</a></h3>
  <p>{d.summary} <span class="yr">{d.year}</span></p>
  {d.status && <p class="small">{d.status}</p>}
</article>
