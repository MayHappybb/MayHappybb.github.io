---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { ideas } from '../../data/ideas';

const notes = (await getCollection('notes')).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Shanghai' });
const label = { done: 'became something', tried: 'tried', open: 'still an idea', dropped: 'dropped' } as const;
---
<Base title="Notes" description="Short stories from research and building, and the ideas jar.">
  <h1>Notes</h1>
  <p class="lead">Short stories from the lab and the desk, and a jar of ideas.</p>

  <ul class="list">
    {notes.map((n) => (
      <li data-icon={n.data.icon}>
        <span class="title"><a href={`/notes/${n.id}/`}>{n.data.title}</a></span>
        {n.data.summary} <span class="where">{fmt(n.data.date)}</span>
      </li>
    ))}
  </ul>

  <h2 data-under id="ideas">Ideas jar</h2>
  <p>I write ideas down as soon as they appear. Knowledge is what makes them: once the groundwork is there, the last missing piece shows up and the idea completes itself. A tick means it became a paper, a tool or a project.</p>
  <ul class="list jar">
    {ideas.map((i) => (
      <li data-done={i.state === 'done' ? '' : undefined}>
        {i.href ? <a href={i.href}>{i.text}</a> : i.text}
        <span class="when"> {[i.date, i.note ?? (i.state !== 'open' ? label[i.state] : '')].filter(Boolean).join(' · ')}</span>
        {i.state === 'dropped' && <span class="sr"> (dropped)</span>}
        {i.state === 'done' && <span class="sr"> (done)</span>}
      </li>
    ))}
  </ul>
</Base>
