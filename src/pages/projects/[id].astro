---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { GROUPS } from '../../content.config';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
---
<Base title={d.title} description={d.summary}>
  <p class="small"><a href={`/projects/#${d.group}`}>{GROUPS[d.group]}</a></p>
  <h1>{d.title}</h1>
  <p class="lead">{d.summary}</p>
  <p class="meta">{d.year}{d.status && <> · {d.status}</>}{d.built && <><br>{d.built}</>}</p>
  {d.links.length > 0 && <div class="links">{d.links.map((l) => <a href={l.href}>{l.label}</a>)}</div>}
  {d.image && (
    <figure class="photo" data-frame>
      <Image src={d.image} alt={d.imageAlt ?? ''} widths={[700, 1400]} sizes="(max-width: 740px) 100vw, 700px" />
    </figure>
  )}
  <div class="prose"><Content /></div>
  <p style="margin-top:40px"><a href="/projects/">All projects</a></p>
</Base>
